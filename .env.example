# Local secrets for smoke / agent CLI — never commit.
# Copy to .env and fill from password manager (or as yaron-admin:
#   aws secretsmanager get-secret-value --secret-id tripmap/agent-bearer \
#     --region eu-central-1 --query SecretString --output text | jq -r .token)
#
# Custom GPT Actions: paste the same Bearer in the GPT editor (not in git).

AGENT_BEARER_TOKEN=

# Hellō (https://console.hello.coop/) — Client ID is public; client secret optional with PKCE.
HELLO_CLIENT_ID=
HELLO_CLIENT_SECRET=
# Defaults to ${PUBLIC_BASE_URL}/auth/hello/callback
# HELLO_REDIRECT_URI=https://tripmap.sheffer.org/auth/hello/callback
# Required when HELLO_CLIENT_ID is set (HMAC for session cookies). ECS: Secrets Manager tripmap/hello-session.
# Quote values with shell metacharacters: HELLO_SESSION_SECRET='...'
HELLO_SESSION_SECRET=
# User ACL (Hellō sign-in): config/users.csv (gitignored). Start from users.example.csv:
#   cp config/users.example.csv config/users.csv
# Optional override:
# USERS_FILE=config/users.csv
PUBLIC_BASE_URL=https://tripmap.sheffer.org
# Optional: /privacy and /terms contact email (default yaronf@gmx.com in code).
# CONTACT_EMAIL=
# Optional: Search Console HTML tag for the home page.
# GOOGLE_SITE_VERIFICATION=

# In-viewer OpenAI chat (Persona). Dark-ships until set; require chat=yes rows in users.csv.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Or JSON from Secrets Manager: {"api_key":"sk-..."}
# OPENAI_SECRET_JSON=
#
# Local chat SSE smoke (see scripts/smoke-chat.sh):
#   ./scripts/smoke-chat.sh http://127.0.0.1:8080 <trip-id>

