{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "schedule:weekly"
  ],
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Skip abandoned agent experiments (eino-mcp, adk-mcp, …)",
      "matchFileNames": ["experiments/**"],
      "enabled": false
    },
    {
      "description": "Group routine Go module bumps (root module)",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["require", "indirect", "replace", "tool"],
      "groupName": "go modules"
    },
    {
      "description": "Group Dockerfile base images and Actions (except golang image)",
      "matchManagers": ["dockerfile", "github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["!golang"],
      "groupName": "ci and docker"
    },
    {
      "description": "Do not bump the go (language) directive automatically",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    },
    {
      "description": "Stay on current Go minor: no toolchain / golang-image minor or major",
      "matchPackageNames": ["go", "golang"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "description": "Prompt Go toolchain + golang image patch PRs (not weekly)",
      "matchPackageNames": ["go", "golang"],
      "matchUpdateTypes": ["patch"],
      "groupName": "go toolchain",
      "schedule": ["at any time"]
    },
    {
      "description": "Descope alone — its go.mod floor can raise ours via gomodTidy",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/descope/go-sdk"],
      "groupName": null
    },
    {
      "description": "Major Go / AWS / Descope / OpenAI bumps stay as separate PRs",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "groupName": null
    }
  ]
}
